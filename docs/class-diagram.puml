            - revocationReason: string|null
            - revocationNote: string
            + constructor({...})
            + get isGuestKeyCard(): boolean
            + statusAt(now): string
            + isUsableAt(now): boolean
            + revoke({reason, note, at, by})
            + endAt(at)
            + validate()
        }

        class StaffMember <<entity>> {
            - id: number|null
            - propertyId: number|null
            - name: string
            - role: string
            + constructor({id, propertyId, name, role})
        }

        class AccessEvent <<entity>> {
            + {static} accessPoints: string[]
            + {static} denialReasons: string[]
            - id: number|null
            - propertyId: number|null
            - occurredAt: string
            - credentialId: number|null
            - cardId: string
            - holderName: string
            - holderType: string
            - accessPoint: string
            - roomId: number|null
            - result: string
            - denialReason: string|null
            + constructor({...})
            + get isDenied(): boolean
        }

        class IssueStaffCredentialCommand <<command>> {
            - staffMemberId: number
            - scope: string
            - validUntil: string|null
            + constructor({staffMemberId, scope, validUntil})
        }

        class IssueGuestKeyCardsCommand <<command>> {
            - bookingId: number
            - bookingCode: string
            - roomId: number
            - holderName: string
            - checkOutDate: string
            - cardIds: string[]
            + constructor({bookingId, bookingCode, roomId, holderName, checkOutDate, cardIds})
        }

        class RevokeCredentialCommand <<command>> {
            - credentialId: number
            - reason: string
            - note: string
            + constructor({credentialId, reason, note})
        }

        class AccessControlError <<error>> {
            - code: string
            + constructor(code)
        }
    }

    package "Infrastructure" as access_control_infrastructure {
        class AccessControlApiService {
            - credentialsEndpoint: BaseEndpoint
            - staffMembersEndpoint: BaseEndpoint
            - accessEventsEndpoint: BaseEndpoint

            + getCredentials(propertyId): Observable
            + createCredential(resource): Observable
            + updateCredential(resource): Observable
            + getStaffMembers(propertyId): Observable
            + getAccessEvents(propertyId): Observable
        }

        class RfidEncoderService <<adapter>> {
            + encode(onState): Promise<string>
        }

        class CredentialAssembler <<assembler>> {
            + {static} toEntityFromResource(resource): Credential
            + {static} toEntitiesFromResponse(response): Credential[]
        }

        class StaffMemberAssembler <<assembler>> {
            + {static} toEntityFromResource(resource): StaffMember
            + {static} toEntitiesFromResponse(response): StaffMember[]
        }

        class AccessEventAssembler <<assembler>> {
            + {static} toEntityFromResource(resource): AccessEvent
            + {static} toEntitiesFromResponse(response): AccessEvent[]
        }
    }

    package "Application" as access_control_application {
        class AccessControlStore <<store>> {
            + credentials: Signal<Credential[]>
            + staffMembers: Signal<StaffMember[]>
            + accessEvents: Signal<AccessEvent[]>
            + errors: Signal<any[]>
            + credentialsLoaded: Signal<boolean>
            + staffMembersLoaded: Signal<boolean>
            + accessEventsLoaded: Signal<boolean>
            + saving: Signal<boolean>
            + encoderState: Signal<string>
            + currentPropertyId: Signal
            + fetchAccessControl()
            + getCredentialById(id): Credential
            + getStaffMemberById(id): StaffMember
            + getCredentialStatus(credential): string
            + getKeyCardsOfBooking(bookingId): Credential[]
            + getEventsOfCredential(credentialId): AccessEvent[]
            + guestAccessEnd(checkOutDate): string
            + encodeKeyCard(): Promise<string>
            + resetEncoder()
            + issueStaffCredential(issueStaffCredentialCommand): Promise
            + issueGuestKeyCards(issueGuestKeyCardsCommand): Promise
            + endGuestKeyCards(bookingId): Promise
            + revokeCredential(revokeCredentialCommand): Promise
            + replaceCredential(credentialId): Promise
        }
    }

    package "Presentation" as access_control_presentation {
        package "Components" as access_control_components {
            class AccessControlLayoutComponent <<component>> {
                - title: string
                - backLink: string
                + changeProperty(propertyId)
                + retry()
            }

            class CredentialStatusTagComponent <<component>> {
                - status: string
            }

            class RfidEncoderPanelComponent <<component>> {
                - showAction: boolean
                - actionLabel: string
                - disabled: boolean
                + encode()
                + encoded: output<string>
            }

            class StaffCredentialFormComponent <<component>> {
                - dialogRef: MatDialogRef
                + issue()
            }

            class RevokeCredentialDialogComponent <<component>> {
                - credential: Credential
                - access: string
                - dialogRef: MatDialogRef
                + revoke()
            }

            class ReplaceCredentialDrawerComponent <<component>> {
                - credential: Credential
                - dialogRef: MatDialogRef
                + replace()
            }

            class AccessEventDrawerComponent <<component>> {
                - accessEvent: AccessEvent
            }
        }

        package "Views" as access_control_views {
            class CredentialListComponent <<component>> {
                + resetFilters()
                + openCredential(credential)
                + issueStaffCredential()
            }

            class CredentialDetailComponent <<component>> {
                + revoke()
                + replace()
                + openEvent(accessEvent)
            }

            class AccessEventListComponent <<component>> {
                + resetFilters()
            }
        }
    }
}

package "Shared" as shared {
    package "Infrastructure" as shared_infrastructure {
        abstract class BaseApiService {
            # http: HttpClient
            # baseUrl: string
            # createEndpoint<T>(path): BaseEndpoint<T>
        }

        class BaseEndpoint<T> {
            - http: HttpClient
            - url: string
            + constructor(http, url)
            + getAll(params): Observable
            + getById(id): Observable
            + create(resource): Observable
            + update(id, resource): Observable
            + delete(id): Observable
        }

        class LocaleLoader <<adapter>> {
            + getTranslation(lang): Observable
        }

        class VueI18nMessageParser <<adapter>> {
            + interpolate(expr, params): string
        }
    }

    package "Presentation" as shared_presentation {
        class CalendarDate <<utility>> {
            + {static} fromDate(date): string
            + {static} toDate(value): Date
            + {static} today(): string
            + {static} addDays(value, days): string
            + {static} addMonths(value, months): string
            + {static} startOfMonth(value): string
            + {static} dayOfWeek(value): number
            + {static} sequence(startDate, length): string[]
        }

        class CalendarFormat <<module>> {
            + formatDay(date, locale, options): string
            + formatDayRange(startDate, endDate, locale): string
            + formatDateTime(value, locale): string
            + moneyLocale(currency, locale): string
            + formatMoney(amount, currency, locale): string
            + currencySymbol(currency, locale): string
        }

        class I18nService <<service>> {
            + locale: Signal<string>
            + t(key, params): string
            + use(locale)
        }

        class LayoutService <<service>> {
            + compact: Signal<boolean>
            + sidebarOpen: Signal<boolean>
        }

        package "Components" as shared_components {
            class AppLayoutComponent <<component>> {
                + collapsed: Signal<boolean>
                + hover(open)
            }

            class ContextLayoutComponent <<component>> {
                - title: string
                - backLink: string
                - properties: PropertyOption[]
                - currentPropertyId: number
                - loaded: boolean
                - failed: boolean
                - body: TemplateRef
                + propertyChange: output<number>
                + retry: output<void>
            }

            class LanguageSwitcherComponent <<component>>
            class BrandLogoComponent <<component>>
            class SidebarToggleComponent <<component>>
            class StatusTagComponent <<component>>
            class MessageComponent <<component>>
        }

        package "Views" as shared_views {
            class HomeComponent <<component>>
        }
    }
}

