package "Inventory Bounded Context" as inventory {
    package "Domain" as inventory_domain {
        class "Property" as InventoryProperty <<entity>> {
            - id: number|null
            - organizationId: number|null
            - name: string
            - city: string
            + constructor({id, organizationId, name, city})
        }

        class InventoryItem <<entity>> {
            + {static} units: string[]
            + {static} categories: string[]
            - id: number|null
            - propertyId: number|null
            - name: string
            - code: string
            - category: string
            - unit: string
            - primaryLocationId: number|null
            - lowStockThreshold: number
            - stocks: object[]
            - adjustments: StockAdjustment[]
            + constructor({...})
            + {static} validateQuantity(quantity, unit, allowZero)
            + get totalQuantity(): number
            + get stockCondition(): string
            + quantityAt(locationId): number
            + assignStorageLocation(locationId)
            + unassignStorageLocation(locationId)
            + applyStockAdjustment(adjustmentData)
            + validate()
        }

        class StockAdjustment <<entity>> {
            + {static} reasons: object
            - id: string
            - operation: string
            - quantity: number
            - locationId: number
            - locationName: string
            - reason: string
            - note: string
            - recordedAt: string
            - operator: string
