@startuml hostera-class-diagram
title Hostera Frontend — Class Diagram
hide empty members

' Angular standalone components list their inputs, models, outputs, and main handlers.
' Dialogs and drawers receive their inputs as MAT_DIALOG_DATA and close with their result through MatDialogRef.
' Stores are injectable services whose state is exposed as Angular signals.
' Calendar days are ISO YYYY-MM-DD strings; date-times are ISO strings.

package "Overview Bounded Context" as overview {
    package "Domain" as overview_domain {
        class DailyPerformance <<entity>> {
            + {static} revenueStatuses: string[]
            - date: string
            - revenue: number
            - soldRooms: number
            - roomsCount: number
            + constructor({date, revenue, soldRooms, roomsCount})
            + get occupancyRate(): number
            + {static} series({bookings, dates, roomsCount}): DailyPerformance[]
        }

        class PropertyOverview <<entity>> {
            - propertyId: number|null
            - name: string
            - roomsCount: number
            - heldRooms: number
            - roomsNeedingCleaning: number
            - roomsOutOfOrder: number
            + constructor({propertyId, name, roomsCount, heldRooms, roomsNeedingCleaning, roomsOutOfOrder})
            + get occupancyRate(): number
            + get availableRooms(): number
            + get alertsCount(): number
        }
    }

    package "Infrastructure" as overview_infrastructure {
        class OverviewApiService {
            - roomsEndpoint: BaseEndpoint
            - bookingsEndpoint: BaseEndpoint
            - statusPeriodsEndpoint: BaseEndpoint
            + getPortfolio(): Observable
        }

        class PropertyOverviewAssembler <<assembler>> {
            + {static} roomHoldingStatuses: string[]
            + {static} toEntitiesFromResponses(properties, responses, today): PropertyOverview[]
        }
    }

    package "Application" as overview_application {
        class OverviewStore <<store>> {
            + propertyOverviews: Signal<PropertyOverview[]>
            + propertyOverviewsLoaded: Signal<boolean>
            + propertyOverviewErrors: Signal<any[]>
            + todaysArrivals: Signal
            + roomStatusCounts: Signal
            + fetchPropertyOverviews()
            + getPerformance(period): object
            + searchBookings(query): Booking[]
        }
    }

    package "Presentation" as overview_presentation {
        package "Components" as overview_components {
            class OverviewPanelComponent <<component>> {
                - title: string
                - subtitle: string
                - loading: boolean
                - failed: boolean
                + retry: output<void>
            }

            class BookingSearchComponent <<component>> {
                + complete(text)
                + openBooking(event)
                + focusSearch(event)
            }

            class RevenueOccupancyCardComponent <<component>>
            class PropertyOverviewCardComponent <<component>>

            class TodaysArrivalsCardComponent <<component>> {
                + arrivalTag(arrival): object
                + stay(checkInDate, checkOutDate): string
            }

            class RoomStatusCardComponent <<component>>

            class ChartCanvasComponent <<component>> {
                - type: ChartType
                - data: ChartData
                - options: ChartOptions
                - ariaLabel: string
            }
        }

        package "Views" as overview_views {
            class OverviewComponent <<component>>
        }
    }
}

package "Bookings Bounded Context" as bookings {
    package "Domain" as bookings_domain {
        class Booking <<entity>> {
            + {static} statuses: string[]
            + {static} roomHoldingStatuses: string[]
            + {static} editableStatuses: string[]
            + {static} cancellationReasons: string[]
            + {static} documentTypes: string[]
            + {static} roomConditions: string[]
            + {static} paymentAcceptingStatuses: string[]
            + {static} preferredLanguages: string[]
            - id: number|null
            - propertyId: number|null
            - code: string
            - status: string
            - guestName: string
            - guestEmail: string
            - guestPhone: string
            - preferredLanguage: string
            - checkInDate: string
            - checkOutDate: string
            - guests: number
            - roomTypeId: number|null
            - roomId: number|null
            - ratePlanId: number|null
            - totalAmount: number
            - guestRequest: string
            - createdAt: string
            - confirmedAt: string|null
            - confirmedBy: string|null
            - cancelledAt: string|null
            - cancelledBy: string|null
            - cancellationReason: string|null
            - cancellationNote: string
            - noShowAt: string|null
            - noShowBy: string|null
            - checkedInAt: string|null
            - checkedInBy: string|null
            - guestDocumentType: string|null
            - guestDocumentNumber: string
            - checkedOutAt: string|null
            - checkedOutBy: string|null
            - roomCondition: string|null
            - departureNote: string
            + {static} nextCode(propertyId, latestCode): string
            + {static} numberOf(code): number
            + constructor({...})
            + get nights(): number
            + get lastNight(): string
            + get holdsRoom(): boolean
            + get isEditable(): boolean
            + get canBeConfirmed(): boolean
            + get canBeCancelled(): boolean
            + get canBeCheckedOut(): boolean
            + get acceptsPayments(): boolean
            + canBeMarkedNoShow(today): boolean
            + canBeRestored(today): boolean
            + canBeCheckedIn(today): boolean
            + confirm(at, by)
            + cancel({reason, note, at, by})
            + markNoShow(today, at, by)
            + restore(today)
            + checkIn({today, documentType, documentNumber, documentVerified, at, by})
            + checkOut({balanceDue, roomCondition, note, at, by})
            + balanceDue(payments): number
            + paymentStatus(payments): string
            + overlaps(checkInDate, checkOutDate): boolean
