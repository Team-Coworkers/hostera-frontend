        class Payment <<entity>> {
            + {static} methods: string[]
            - id: number|null
            - propertyId: number|null
            - bookingId: number|null
            - amount: number
            - method: string
            - paidAt: string
            - reference: string
            - recordedBy: string|null
            + constructor({...})
            + validate()
        }

        class CancelBookingCommand <<command>> {
            - bookingId: number
            - reason: string
            - note: string
            + constructor({bookingId, reason, note})
        }

        class CheckInBookingCommand <<command>> {
            - bookingId: number
            - documentType: string
            - documentNumber: string
            - documentVerified: boolean
            - keyCardIds: string[]
            + constructor({bookingId, documentType, documentNumber, documentVerified, keyCardIds})
        }

        class CheckOutBookingCommand <<command>> {
            - bookingId: number
            - roomCondition: string
            - note: string
            + constructor({bookingId, roomCondition, note})
        }

        class BookingsError <<error>> {
            - code: string
            + constructor(code)
        }
    }

    package "Infrastructure" as bookings_infrastructure {
        class BookingsApiService {
            - bookingsEndpoint: BaseEndpoint
            - paymentsEndpoint: BaseEndpoint
            + getBookings(propertyId): Observable
            + getLatestBooking(propertyId): Observable
            + createBooking(resource): Observable
            + updateBooking(resource): Observable
            + getPayments(propertyId): Observable
            + createPayment(resource): Observable
        }

        class BookingAssembler <<assembler>> {
            + {static} toEntityFromResource(resource): Booking
            + {static} toEntitiesFromResponse(response): Booking[]
        }

        class PaymentAssembler <<assembler>> {
            + {static} toEntityFromResource(resource): Payment
            + {static} toEntitiesFromResponse(response): Payment[]
        }
    }

    package "Application" as bookings_application {
        class BookingsStore <<store>> {
            + bookings: Signal<Booking[]>
            + payments: Signal<Payment[]>
            + errors: Signal<any[]>
            + bookingsLoaded: Signal<boolean>
            + paymentsLoaded: Signal<boolean>
            + saving: Signal<boolean>
            + currentPropertyId: Signal
            + bookingsCount: Signal
            + fetchBookings()
            + getBookingById(id): Booking
            + getPaymentsOf(bookingId): Payment[]
            + getBalanceDue(booking): number
            + getPaymentStatus(booking): string
            + quoteTotal(booking): number
            + isRoomAvailable(roomId, booking): boolean
            + addBooking(booking): Promise
            + updateBooking(booking): Promise
            + confirmBooking(bookingId): Promise
            + cancelBooking(cancelBookingCommand): Promise
            + markNoShow(bookingId): Promise
            + restoreBooking(bookingId): Promise
            + recordPayment(payment): Promise
            + checkInBooking(checkInBookingCommand): Promise
            + checkOutBooking(checkOutBookingCommand): Promise
        }
    }

    package "Presentation" as bookings_presentation {
        package "Components" as bookings_components {
            class BookingsLayoutComponent <<component>> {
                - title: string
                + changeProperty(propertyId)
                + retry()
            }

            class BookingStatusTagComponent <<component>> {
                - status: string
            }

            class PaymentStatusTagComponent <<component>> {
                - status: string
            }

            class BookingStatusDialogComponent <<component>> {
                - booking: Booking
                - action: string
                - dialogRef: MatDialogRef
                + apply()
            }

            class BookingCancelDialogComponent <<component>> {
                - booking: Booking
                - dialogRef: MatDialogRef
                + cancel()
            }

            class BookingPaymentSummaryComponent <<component>> {
                - booking: Booking
                + recordPayment()
            }

            class PaymentFormComponent <<component>> {
                - booking: Booking
                - dialogRef: MatDialogRef
                + savePayment()
            }
        }

        package "Views" as bookings_views {
            class BookingListComponent <<component>> {
                + resetFilters()
                + openBooking(booking)
            }

            class BookingDetailComponent <<component>> {
                + restore()
                + duplicate()
                + notifySaved(message)
            }

            class BookingFormComponent <<component>> {
                + saveBooking()
                + cancel()
            }

            class BookingCheckInComponent <<component>> {
                + completeCheckIn()
            }

            class BookingCheckOutComponent <<component>> {
                + completeCheckOut()
            }
        }
    }
}

package "Rooms Bounded Context" as rooms {
