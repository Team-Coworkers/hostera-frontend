@startuml hostera-class-diagram
title Hostera Frontend — Class Diagram
hide empty members

' Vue components list their props, models, and main handlers.
' Calendar days are ISO YYYY-MM-DD strings; date-times are ISO strings.

package "Overview Bounded Context" as overview {
    package "Domain" as overview_domain {
        class DailyPerformance <<entity>> {
            + {static} revenueStatuses: string[]
            - date: string
            - revenue: number
            - soldRooms: number
            - roomsCount: number
            + constructor({date, revenue, soldRooms, roomsCount})
            + get occupancyRate(): number
            + {static} series({bookings, dates, roomsCount}): DailyPerformance[]
        }

        class PropertyOverview <<entity>> {
            - propertyId: number|null
            - name: string
            - roomsCount: number
            - heldRooms: number
            - roomsNeedingCleaning: number
            - roomsOutOfOrder: number
            + constructor({propertyId, name, roomsCount, heldRooms, roomsNeedingCleaning, roomsOutOfOrder})
            + get occupancyRate(): number
            + get availableRooms(): number
            + get alertsCount(): number
        }
    }

    package "Infrastructure" as overview_infrastructure {
        class OverviewApi {
            - roomsEndpoint: BaseEndpoint
            - bookingsEndpoint: BaseEndpoint
            - statusPeriodsEndpoint: BaseEndpoint
            + constructor()
            + getPortfolio(): Promise
        }

        class PropertyOverviewAssembler <<assembler>> {
            + {static} roomHoldingStatuses: string[]
            + {static} toEntitiesFromResponses(properties, responses, today): PropertyOverview[]
        }
    }

    package "Application" as overview_application {
        class OverviewStore <<store>> {
            - propertyOverviews: PropertyOverview[]
            - propertyOverviewsLoaded: boolean
            - propertyOverviewErrors: any[]
            + todaysArrivals: computed
            + roomStatusCounts: computed
            + fetchPropertyOverviews()
            + getPerformance(period): object
            + searchBookings(query): Booking[]
        }
    }

    package "Presentation" as overview_presentation {
        package "Components" as overview_components {
            class OverviewPanel <<component>> {
                - title: string
                - subtitle: string
                - loading: boolean
                - failed: boolean
                + emit retry
            }

            class BookingSearch <<component>> {
                + complete(event)
                + openBooking(event)
                + focusSearch(event)
            }

            class RevenueOccupancyCard <<component>>
            class PropertyOverviewCard <<component>>

            class TodaysArrivalsCard <<component>> {
                + arrivalTag(arrival): object
                + openActions(event, arrival)
            }

            class RoomStatusCard <<component>>
        }

        package "Views" as overview_views {
            class OverviewView <<component>>
        }
    }
}

package "Bookings Bounded Context" as bookings {
    package "Domain" as bookings_domain {
        class Booking <<entity>> {
            + {static} statuses: string[]
            + {static} roomHoldingStatuses: string[]
            + {static} editableStatuses: string[]
            + {static} cancellationReasons: string[]
            + {static} documentTypes: string[]
            + {static} roomConditions: string[]
            + {static} paymentAcceptingStatuses: string[]
            + {static} preferredLanguages: string[]
            - id: number|null
            - propertyId: number|null
            - code: string
            - status: string
            - guestName: string
            - guestEmail: string
            - guestPhone: string
            - preferredLanguage: string
            - checkInDate: string
            - checkOutDate: string
            - guests: number
            - roomTypeId: number|null
            - roomId: number|null
            - ratePlanId: number|null
            - totalAmount: number
            - guestRequest: string
            - createdAt: string
            - confirmedAt: string|null
            - confirmedBy: string|null
            - cancelledAt: string|null
            - cancelledBy: string|null
            - cancellationReason: string|null
            - cancellationNote: string
            - noShowAt: string|null
            - noShowBy: string|null
            - checkedInAt: string|null
            - checkedInBy: string|null
            - guestDocumentType: string|null
            - guestDocumentNumber: string
            - checkedOutAt: string|null
            - checkedOutBy: string|null
            - roomCondition: string|null
            - departureNote: string
            + {static} nextCode(propertyId, latestCode): string
            + {static} numberOf(code): number
            + constructor({...})
            + get nights(): number
            + get lastNight(): string
            + get holdsRoom(): boolean
            + get isEditable(): boolean
            + get canBeConfirmed(): boolean
            + get canBeCancelled(): boolean
            + get canBeCheckedOut(): boolean
            + get acceptsPayments(): boolean
            + canBeMarkedNoShow(today): boolean
            + canBeRestored(today): boolean
            + canBeCheckedIn(today): boolean
            + confirm(at, by)
            + cancel({reason, note, at, by})
            + markNoShow(today, at, by)
            + restore(today)
            + checkIn({today, documentType, documentNumber, documentVerified, at, by})
            + checkOut({balanceDue, roomCondition, note, at, by})
            + balanceDue(payments): number
            + paymentStatus(payments): string
            + overlaps(checkInDate, checkOutDate): boolean
            + hasSamePricingAs(booking): boolean
            + validate()
        }

        class Payment <<entity>> {
            + {static} methods: string[]
            - id: number|null
            - propertyId: number|null
            - bookingId: number|null
            - amount: number
            - method: string
            - paidAt: string
            - reference: string
            - recordedBy: string|null
            + constructor({...})
            + validate()
        }

        class CancelBookingCommand <<command>> {
            - bookingId: number
            - reason: string
            - note: string
            + constructor({bookingId, reason, note})
        }

        class CheckInBookingCommand <<command>> {
            - bookingId: number
            - documentType: string
            - documentNumber: string
            - documentVerified: boolean
            - keyCardIds: string[]
            + constructor({bookingId, documentType, documentNumber, documentVerified, keyCardIds})
        }

        class CheckOutBookingCommand <<command>> {
            - bookingId: number
            - roomCondition: string
            - note: string
            + constructor({bookingId, roomCondition, note})
        }

        class BookingsError <<error>> {
            - code: string
            + constructor(code)
        }
    }

    package "Infrastructure" as bookings_infrastructure {
        class BookingsApi {
            - bookingsEndpoint: BaseEndpoint
            - paymentsEndpoint: BaseEndpoint
            + constructor()
            + getBookings(propertyId): Promise
            + getLatestBooking(propertyId): Promise
            + createBooking(resource): Promise
            + updateBooking(resource): Promise
            + getPayments(propertyId): Promise
            + createPayment(resource): Promise
        }

        class BookingAssembler <<assembler>> {
            + {static} toEntityFromResource(resource): Booking
            + {static} toEntitiesFromResponse(response): Booking[]
        }

        class PaymentAssembler <<assembler>> {
            + {static} toEntityFromResource(resource): Payment
            + {static} toEntitiesFromResponse(response): Payment[]
        }
    }

    package "Application" as bookings_application {
        class BookingsStore <<store>> {
            - bookings: Booking[]
            - payments: Payment[]
            - errors: any[]
            - bookingsLoaded: boolean
            - paymentsLoaded: boolean
            - saving: boolean
            + currentPropertyId: computed
            + bookingsCount: computed
            + fetchBookings()
            + getBookingById(id): Booking
            + getPaymentsOf(bookingId): Payment[]
            + getBalanceDue(booking): number
            + getPaymentStatus(booking): string
            + quoteTotal(booking): number
            + isRoomAvailable(roomId, booking): boolean
            + addBooking(booking): Promise
            + updateBooking(booking): Promise
            + confirmBooking(bookingId): Promise
            + cancelBooking(cancelBookingCommand): Promise
            + markNoShow(bookingId): Promise
            + restoreBooking(bookingId): Promise
            + recordPayment(payment): Promise
            + checkInBooking(checkInBookingCommand): Promise
            + checkOutBooking(checkOutBookingCommand): Promise
        }
    }

    package "Presentation" as bookings_presentation {
        package "Components" as bookings_components {
            class BookingsLayout <<component>> {
                - title: string
                + changeProperty(propertyId)
                + retry()
            }

            class BookingStatusTag <<component>> {
                - status: string
            }

            class PaymentStatusTag <<component>> {
                - status: string
            }

            class BookingStatusDialog <<component>> {
                - booking: Booking
                - action: string
                - type: string
                - required: boolean
                - validator: function
                - visible: boolean (model)
                + apply()
                + emit saved
            }

            class BookingCancelDialog <<component>> {
                - booking: Booking
                - visible: boolean (model)
                + cancel()
                + emit saved
            }

            class BookingPaymentSummary <<component>> {
                - booking: Booking
                + notifyRecorded()
            }

            class PaymentForm <<component>> {
                - booking: Booking
                - visible: boolean (model)
                + savePayment()
                + emit saved
            }
        }

        package "Views" as bookings_views {
            class BookingList <<component>> {
                + resetFilters()
                + openBooking(booking)
            }

            class BookingDetail <<component>> {
                + restore()
                + duplicate()
                + notifySaved(message)
            }

            class BookingForm <<component>> {
                + saveBooking()
                + cancel()
            }

            class BookingCheckIn <<component>> {
                + completeCheckIn()
            }

            class BookingCheckOut <<component>> {
                + completeCheckOut()
            }
        }
    }
}

