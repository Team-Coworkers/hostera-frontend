{
  "name": "hostera-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier \"{src,server}/**/*\" index.html --write --ignore-unknown",
    "format:check": "prettier \"{src,server}/**/*\" index.html --check --ignore-unknown",
    "server:build": "node server/build-db.js",
    "server:start": "sh server/start.sh"
  },
  "dependencies": {
    "@primeuix/themes": "^3.0.1",
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "pinia": "^4.0.3",
    "primeflex": "^4.0.0",
    "primeicons": "^8.0.2",
    "primevue": "^5.0.2",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "json-server": "^0.17.4",
    "prettier": "3.9.9",
    "vite": "^8.3.2"
  }
}
